--- !u!114 &801731572
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 801731571}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ce39aa8c47244f4599c87be419df826, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TakeUp.Prototype.DispatchTutorial
  officeImage: {fileID: 0}
  dispatchRoomImage: {fileID: 0}
  simulationImage: {fileID: 0}
  playerImage: {fileID: 21300000, guid: 3a424d8b8b87545499634cd6dbd0f485, type: 3}
  jaeheeImage: {fileID: 21300000, guid: 91b5cc664c1d916458226058c737662b, type: 3}
  coffinImage: {fileID: 0}
  movementGuide: {fileID: 0}
  attackGuide: {fileID: 0}
  dashGuide: {fileID: 0}
  missionImage: {fileID: 0}
  joseonImages: []
  officeLines:
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uC774\uCABD\uC740 \uCD9C\uB3D9 \uC900\uBE44\uC2E4\uC774\uC5D0\uC694.
      \uC5EC\uAE30 \uC549\uC73C\uC138\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  simulationLines:
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uC2DC\uBBAC\uB808\uC774\uC158 \uC2DC\uC791\uD560\uAC8C\uC694. \uBA3C\uC800
      \uC774\uB3D9\uBD80\uD130 \uD574\uBCF4\uC138\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uC870\uC791 \uC124\uBA85\uC740 \uC606\uC5D0 \uB744\uC6CC\uB4DC\uB9B4\uAC8C\uC694.
      \uC800\uB294 \uC7A0\uAE50 \uB208 \uC880\u2026 \uC544\uB2C8, \uBCF4\uACE0 \uC788\uC744\uAC8C\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  missionLines:
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uBE68\uB9AC \uD558\uC168\uB124\uC694\u314E\u314E\u2026 \uC774\uC81C
      \uC784\uBB34 \uC124\uBA85\uD560\uAC8C\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uD30C\uACAC\uC9C0\uB294 \uC870\uC120\uC774\uC5D0\uC694. \uC624\uB798\uB41C
      \uBD09\uC778\uC11D\uC5D0\uC11C \uC2DC\uAC04 \uC870\uAC01\uC774 \uC0AC\uB77C\uC9C4
      \uB4A4 \uADE0\uC5F4\uC774 \uC0DD\uACBC\uC5B4\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uC11C\uB85C \uB2E4\uB978 \uC2DC\uAC04\uC774 \uB4A4\uC11E\uC774\uBA74\uC11C
      \uB3C4\uAE68\uBE44\uBD88\uACFC \uADF8\uB9BC\uC790\uD638\uB791\uC774\uAC00 \uB098\uD0C0\uB098\uACE0
      \uC788\uC5B4\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uADE0\uC5F4\uC744 \uAC00\uB85C\uB9C9\uB294 \uBA39\uBB3C \uC694\uAD34\uB97C
      \uCC98\uB9AC\uD558\uACE0, \uC0AC\uB77C\uC9C4 \uC870\uAC01\uC758 \uD754\uC801\uC744
      \uCC3E\uC544\uC8FC\uC138\uC694. \uB204\uAC00 \uAC00\uC838\uAC14\uB294\uC9C0\uB294
      \uC544\uC9C1 \uBAB0\uB77C\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uC124\uBA85 \uB05D\uB0AC\uC5B4\uC694. \uC774\uC81C \uC637 \uBC97\uC5B4\uC8FC\uC138\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    dialogue: "\uB124?! \uAC11\uC790\uAE30\uC694?!"
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uAC89\uC637\uC774\uC694. \uC804\uC1A1 \uC7A5\uCE58\uC5D0 \uB07C\uC5B4\uC694.
      \uC774\uC0C1\uD55C \uC0DD\uAC01 \uD558\uC9C0 \uB9C8\uC138\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    dialogue: "\uC800 \uAD00\uCC98\uB7FC \uC0DD\uAE34 \uAC8C\u2026 \uC804\uC1A1 \uC7A5\uCE58\uB77C\uACE0\uC694?"
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C"
    portrait: {fileID: 0}
    dialogue: "\uB124. \uC900\uBE44\uB410\uC73C\uBA74 \uD0D1\uC2B9 \uB20C\uB7EC\uC8FC\uC138\uC694.
      \uC800\uB294 \uC774\uC81C \uC798 \uAC70\uC608\uC694. \uAC74\uB4E4\uC9C0 \uB9D0\uC544\uC8FC\uC138\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  arrivalLines:
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    dialogue: "\uC5EC\uAE30\uAC00 \uC870\uC120\u2026? \uBD84\uC704\uAE30\uAC00 \uC2EC\uC0C1\uCE58
      \uC54A\uC740\uB370."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  - speaker: "\uCD5C\uC7AC\uD76C \xB7 \uD1B5\uC2E0"
    portrait: {fileID: 0}
    dialogue: "\uADE0\uC5F4 \uC8FC\uBCC0\uC5D0\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC5C6\uC5B4\uC694.
      \uC6C0\uC9C1\uC774\uB294 \uAC8C \uBCF4\uC774\uBA74 \uC870\uC2EC\uD558\uC138\uC694."
    voiceMp4: {fileID: 0}
    voiceAudio: {fileID: 0}
  panDuration: 1.5
  coffinDropDuration: 1
  ascentDuration: 1.2
  arrivalImageDuration: 2
  moveSpeed: 5
  dashDistance: 3
  dashDuration: 0.18
  requiredHits: 3
  gameScene: PrehistoricPrototype
  sceneCamera: {fileID: 2007469168}
